From: TacoRocket
Subject: [PATCH] renderer: opt-in fused NV12 luminance write and RG16F chroma scratch

Requires explicit ETV_INLINE_NV12_RTZ=1. This assumes the observed Intel ANV
fp16 attachment truncation; it is not a portable rounding guarantee. Preserve
the existing output on unsupported layouts/backends/features. No public API
or shader change. Dispatch failures remain visible rather than being hidden.

Based on libplacebo v7.360.1, cee9b076f2c63104ccfd497fa79c39a867293ec4.
---
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -24,6 +24,9 @@
 #include "dispatch.h"
 
 #include <libplacebo/renderer.h>
+#if PL_HAVE_VULKAN
+#include <libplacebo/vulkan.h>
+#endif
 
 struct cached_frame {
     uint64_t signature;
@@ -86,6 +89,8 @@
 
     // For debugging / logging purposes
     int prev_dither;
+    bool inline_nv12_logged;
+    bool inline_nv12_fallback_logged;
 
     // For backwards compatibility
     struct icc_state icc_fallback[2];
@@ -2640,6 +2645,122 @@
                                                   PL_INTENT_RELATIVE_COLORIMETRIC);
     pl_matrix3x3_apply(&tr, out_color);
     pl_color_delinearize(csp, out_color);
+}
+
+// Returns 1 when used, 0 to retain the original path, -1 on dispatch failure.
+static int inline_nv12_output(struct pass_state *pass, float scale)
+{
+    pl_renderer rr = pass->rr;
+    const struct pl_render_params *params = pass->params;
+    const struct pl_frame *target = &pass->target;
+    struct img *img = &pass->img;
+    const struct pl_plane *y = &target->planes[0];
+    const struct pl_plane *uv = &target->planes[1];
+    pl_fmt original = img->fmt ? img->fmt : pass->fbofmt[img->comps];
+    pl_fmt scratch = pass->fbofmt[2];
+    bool output_hook = false;
+#if PL_HAVE_VULKAN
+    pl_vulkan vk = pl_vulkan_get(rr->gpu);
+    if (!vk || !vk->features || !vk->features->features.fragmentStoresAndAtomics)
+        goto unsupported;
+#else
+    goto unsupported;
+#endif
+    for (int i = 0; i < params->num_hooks; i++)
+        output_hook |= !!(params->hooks[i]->stages & PL_HOOK_OUTPUT);
+
+    if (target->num_planes != 2 || pass->dst_ref != 0 || pass->rotation ||
+        target->repr.sys != PL_COLOR_SYSTEM_BT_709 ||
+        pl_color_space_is_hdr(&target->color) ||
+        target->repr.bits.color_depth != 8 ||
+        params->blend_params || params->error_diffusion || output_hook ||
+        pass->image.num_overlays || target->num_overlays ||
+        pl_frame_is_cropped(target) || y->flipped || uv->flipped ||
+        y->components != 1 || y->component_mapping[0] != 0 ||
+        uv->components != 2 || uv->component_mapping[0] != 1 ||
+        uv->component_mapping[1] != 2 || y->shift_x || y->shift_y ||
+        !y->texture->params.storable ||
+        y->texture->params.format->type != PL_FMT_UNORM ||
+        y->texture->params.format->component_depth[0] != 8 ||
+        uv->texture->params.format->type != PL_FMT_UNORM ||
+        uv->texture->params.format->component_depth[0] != 8 ||
+        uv->texture->params.format->component_depth[1] != 8 ||
+        img->w != 1920 || img->h != 1080 ||
+        y->texture->params.w != img->w || y->texture->params.h != img->h ||
+        uv->texture->params.w * 2 != img->w ||
+        uv->texture->params.h * 2 != img->h ||
+        pass->dst_rect.x0 || pass->dst_rect.y0 ||
+        pass->dst_rect.x1 != img->w || pass->dst_rect.y1 != img->h ||
+        !original || !scratch || original->type != PL_FMT_FLOAT ||
+        original->component_depth[0] != 16 ||
+        original->component_depth[1] != 16 ||
+        original->component_depth[2] != 16 ||
+        scratch->type != PL_FMT_FLOAT || scratch->num_components != 2 ||
+        scratch->component_depth[0] != 16 ||
+        scratch->component_depth[1] != 16 ||
+        !(scratch->caps & PL_FMT_CAP_STORABLE))
+    {
+        goto unsupported;
+    }
+
+    pl_tex tex = get_fbo(pass, img->w, img->h, scratch, 2, PL_DEBUG_TAG);
+    if (!tex)
+        return -1;
+    pl_shader sh = img_sh(pass, img);
+    ident_t output = sh_desc(sh, (struct pl_shader_desc) {
+        .binding.object = y->texture,
+        .desc = {
+            .name = "nv12_y_output",
+            .type = PL_DESC_STORAGE_IMG,
+            .access = PL_DESC_ACCESS_WRITEONLY,
+        },
+    });
+
+    // Opt-in assumes fp16 attachment truncation, as measured on Intel ANV.
+    // Vulkan does not promise this rounding on other devices.
+    // UV must remain undithered until after the unchanged chroma filter.
+    GLSL("vec2 inline_uv = color.gb;\n"
+         "uint inline_half = packHalf2x16(vec2(color.r, 0.0)) & 65535u;\n"
+         "if (abs(unpackHalf2x16(inline_half).r) > abs(color.r))\n"
+         "    inline_half -= 1u;\n"
+         "color.r = unpackHalf2x16(inline_half).r;\n");
+    if (params->dither_params) {
+        struct pl_dither_params dparams = *params->dither_params;
+        if (!params->disable_dither_gamma_correction)
+            dparams.transfer = target->color.transfer;
+        pl_shader_dither(sh, 8, &rr->dither_state, &dparams);
+    }
+    // Compute producers can run beyond the target's last row/workgroup.
+    GLSL("ivec2 inline_pos = ivec2(gl_FragCoord.xy);\n"
+         "if (all(greaterThanEqual(inline_pos, ivec2(0))) &&\n"
+         "    all(lessThan(inline_pos, imageSize("$"))))\n"
+         "    imageStore("$", inline_pos, vec4(color.r / "$", 0.0, 0.0, 1.0));\n"
+         "color = vec4(inline_uv, 0.0, 1.0);\n", output, output, SH_FLOAT(scale));
+    sh_describe(sh, "inline NV12 Y output and UV scratch");
+    if (!rr->inline_nv12_logged) {
+        PL_INFO(rr, "ETV_INLINE_NV12_RTZ: accepted original=%s scratch=%s producer=%s",
+                original->name, scratch->name,
+                pl_shader_is_compute(sh) ? "compute" : "fragment");
+        rr->inline_nv12_logged = true;
+    }
+    if (!pl_dispatch_finish(rr->dp, pl_dispatch_params(
+            .shader = &img->sh, .target = tex)))
+        return -1;
+
+    img->tex = tex;
+    img->fmt = NULL;
+    img->comps = 2;
+    img->err_msg = NULL;
+    img->err_enum = PL_RENDER_ERR_NONE;
+    img->err_tex = NULL;
+    return 1;
+
+unsupported:
+    if (!rr->inline_nv12_fallback_logged) {
+        PL_INFO(rr, "ETV_INLINE_NV12_RTZ: unsupported layout or capability; using original output");
+        rr->inline_nv12_fallback_logged = true;
+    }
+    return 0;
 }
 
 static bool pass_output_target(struct pass_state *pass)
@@ -2861,7 +2982,15 @@
         clear_target(rr, target, border_tex, scale, params);
     }
 
-    for (int p = 0; p < target->num_planes; p++) {
+    const char *inline_env = getenv("ETV_INLINE_NV12_RTZ");
+    int inline_nv12 = 0;
+    if (inline_env && !strcmp(inline_env, "1")) {
+        inline_nv12 = inline_nv12_output(pass, scale);
+        if (inline_nv12 < 0)
+            return false;
+    }
+
+    for (int p = inline_nv12 ? 1 : 0; p < target->num_planes; p++) {
         const struct pl_plane *plane = &target->planes[p];
         float rx = (float) plane->texture->params.w / ref->texture->params.w,
               ry = (float) plane->texture->params.h / ref->texture->params.h;
@@ -2905,7 +3034,8 @@
                     .y0 = (ry0 - plane_rectf.y0) / rry,
                     .y1 = (ry1 - plane_rectf.y0) / rry,
                 },
-                .component_mask = plane_comps(plane, params),
+                .components = inline_nv12 ? 2 : 0,
+                .component_mask = inline_nv12 ? 0 : plane_comps(plane, params),
             };
 
             if (!src.tex) {
@@ -2941,6 +3071,9 @@
             img->sh = NULL;
 
         }
+
+        if (inline_nv12)
+            GLSL("color = vec4(0.0, color.rg, 1.0);\n");
 
         // Ignore dithering for > 16-bit outputs by default, since it makes
         // little sense to do so (and probably just adds errors)
