+/* ASS drawings are commands, not caption text. Karaoke Templater also
+ * marks its generated events "fx"; clipped, positioned one- or two-letter
+ * fragments of these effects become independent captions if flattened. */
+static int webvtt_strip_ass_artwork(ASSDialog *dialog)
+{
+    char *src = dialog->text, *dst = src;
+    int fx = dialog->effect && !strcmp(dialog->effect, "fx");
+    int positioned = 0, clipped = 0, drawing = 0, had_drawing = 0;
+    size_t text_bytes = 0;
+    int letters_only = 1;
+
+    if (!src || (!fx && !strstr(src, "\\p")))
+        return 0;
+
+    while (*src) {
+        if (*src == '{' && src[1] == '\\') {
+            const char *end = strchr(src + 2, '}');
+            size_t len;
+            int depth = 0;
+            if (!end) {
+                memmove(dst, src, strlen(src) + 1);
+                return 0;
+            }
+            for (const char *tag = src + 1; tag < end; tag++) {
+                if (*tag == '(') {
+                    depth++;
+                } else if (*tag == ')' && depth) {
+                    depth--;
+                } else if (!depth && *tag == '\\') {
+                    if (tag[1] == 'p' && av_isdigit(tag[2]))
+                        drawing = strtol(tag + 2, NULL, 10) > 0;
+                    else if (tag[1] == 'r')
+                        drawing = 0;
+                    else if (fx && (!strncmp(tag, "\\pos(", 5) ||
+                                    !strncmp(tag, "\\move(", 6)))
+                        positioned = 1;
+                    else if (fx && !strncmp(tag, "\\clip(", 6))
+                        clipped = 1;
+                }
+            }
+            len = end + 1 - src;
+            if (dst != src)
+                memmove(dst, src, len);
+            dst += len;
+            src += len;
+        } else if (drawing) {
+            had_drawing = 1;
+            src++;
+        } else {
+            int ch = av_tolower(*src);
+            letters_only &= ch == ' ' || (ch >= 'a' && ch <= 'z');
+            text_bytes++;
+            *dst++ = *src++;
+        }
+    }
+    *dst = 0;
+    return (had_drawing && !text_bytes) ||
+           (!had_drawing && fx && positioned && clipped &&
+            letters_only && text_bytes <= 2);
+}
