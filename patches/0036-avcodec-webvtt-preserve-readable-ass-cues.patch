+static int webvtt_set_position(WebVTTContext *s)
+{
+    const ASSScriptInfo *info = &((const ASS *)s->ass_ctx)->script_info;
+    static const char *const horizontal[] = { "left", "center", "right" };
+    static const char *const vertical[]   = { "end", "center", "start" };
+    int x, y, anchor;
+
+    if (info->play_res_x <= 0 || info->play_res_y <= 0 ||
+        !(s->x >= 0 && s->x <= info->play_res_x &&
+          s->y >= 0 && s->y <= info->play_res_y) ||
+        s->alignment < 1 || s->alignment > 9)
+        return 0;
+
+    anchor = s->alignment - 1;
+    x = (int)(1000 * s->x / info->play_res_x + 0.5);
+    y = (int)(1000 * s->y / info->play_res_y + 0.5);
+    s->cue_settings = av_asprintf("line:%d.%d%%,%s position:%d.%d%% align:%s",
+                                  y / 10, y % 10, vertical[anchor / 3],
+                                  x / 10, x % 10, horizontal[anchor % 3]);
+    return s->cue_settings ? 0 : AVERROR(ENOMEM);
+}
