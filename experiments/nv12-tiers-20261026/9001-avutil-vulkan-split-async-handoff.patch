+/* ETV_VAAPI_NV12_ASYNC=0 keeps the writable NV12 target but restores the
+ * synchronous reverse wait and the default compute exec pool size. */
+static int nv12_async_enabled(void)
+{
+    const char *value;
+
+    if (!direct_nv12_enabled())
+        return 0;
+    value = getenv("ETV_VAAPI_NV12_ASYNC");
+    return !value || strcmp(value, "0");
+}
